{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "maxLength": 120,
      "default": ""
    },
    "heading": {
      "type": "string",
      "maxLength": 200,
      "default": ""
    },
    "intro": {
      "type": "string",
      "maxLength": 400,
      "default": ""
    },
    "source": {
      "type": "string",
      "enum": [
        "featured_projects",
        "published_projects"
      ],
      "default": "published_projects"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "default": 12
    },
    "fallback_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "maxLength": 200
          },
          "caption": {
            "type": "string",
            "maxLength": 200
          },
          "image": {
            "type": "string",
            "maxLength": 200
          },
          "alt": {
            "type": "string",
            "maxLength": 200
          },
          "href": {
            "type": "string",
            "maxLength": 300,
            "default": ""
          }
        },
        "required": [
          "title",
          "image",
          "alt"
        ]
      }
    }
  }
}
