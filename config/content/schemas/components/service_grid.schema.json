{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "maxLength": 120,
      "default": ""
    },
    "heading": {
      "type": "string",
      "maxLength": 200,
      "default": ""
    },
    "intro": {
      "type": "string",
      "maxLength": 400,
      "default": ""
    },
    "source": {
      "type": "string",
      "enum": [
        "featured_services",
        "published_services"
      ],
      "default": "published_services"
    },
    "columns": {
      "type": "integer",
      "enum": [
        2,
        3
      ],
      "default": 3
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "default": 12
    },
    "fallback_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "maxLength": 400
          },
          "category": {
            "type": "string",
            "maxLength": 80
          },
          "image": {
            "type": "string",
            "maxLength": 200
          },
          "alt": {
            "type": "string",
            "maxLength": 200
          },
          "href": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
