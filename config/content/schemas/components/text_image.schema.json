{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "maxLength": 120,
      "default": ""
    },
    "heading": {
      "type": "string",
      "maxLength": 200
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1200
      }
    },
    "image": {
      "type": "string",
      "maxLength": 200
    },
    "image_alt": {
      "type": "string",
      "maxLength": 200
    },
    "cta_label": {
      "type": "string",
      "maxLength": 80,
      "default": ""
    },
    "cta_href": {
      "type": "string",
      "maxLength": 300,
      "default": ""
    },
    "image_position": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "right"
    }
  },
  "required": [
    "heading",
    "paragraphs",
    "image",
    "image_alt"
  ]
}
