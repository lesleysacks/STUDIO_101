{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "maxLength": 120,
      "default": ""
    },
    "heading": {
      "type": "string",
      "maxLength": 200
    },
    "intro": {
      "type": "string",
      "maxLength": 400,
      "default": ""
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "icon": {
            "type": "string",
            "pattern": "^fa-[a-z0-9-]+$",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "icon",
          "title",
          "text"
        ]
      }
    }
  },
  "required": [
    "heading",
    "items"
  ]
}
