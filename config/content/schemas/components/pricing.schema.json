{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "maxLength": 120,
      "default": ""
    },
    "heading": {
      "type": "string",
      "maxLength": 200
    },
    "intro": {
      "type": "string",
      "maxLength": 400,
      "default": ""
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 80
          },
          "subtitle": {
            "type": "string",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "amount": {
            "type": "string",
            "maxLength": 40
          },
          "duration": {
            "type": "string",
            "maxLength": 80
          },
          "featured": {
            "type": "boolean",
            "default": false
          },
          "badge": {
            "type": "string",
            "maxLength": 40,
            "default": ""
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "cta_label": {
            "type": "string",
            "maxLength": 80
          },
          "cta_href": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "title",
          "amount",
          "duration",
          "features",
          "cta_label",
          "cta_href"
        ]
      }
    }
  },
  "required": [
    "heading",
    "plans"
  ]
}
